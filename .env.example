# Copy to .env on the VPS (never commit the real .env).
#
# This file only covers docker-compose's own top-level substitutions. The
# secrets (ADMIN_PASSWORD_HASH, API_TOKEN, MCP_AUTH_TOKEN) live in
# apps/backend/.env and apps/mcp-server/.env instead, loaded via env_file —
# NOT here — because bcrypt hashes and tokens can contain "$" characters
# that docker-compose's ${VAR} interpolation would otherwise corrupt. See
# apps/backend/.env.example and apps/mcp-server/.env.example.

# Your domain, pointed at the VPS's external IP via an A record.
# Use ":80" for local/IP-only testing (no TLS).
DOMAIN=life.bawgz.com
