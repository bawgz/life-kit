# Build context is the repo root. Build with:
#   docker build -f infra/Dockerfile.caddy -t life-kit-caddy .
#
# Builds the frontend's static assets and bundles them into a Caddy image
# alongside the Caddyfile, which also reverse-proxies /api and /mcp to the
# other two containers.

FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/frontend/package.json apps/frontend/package.json
RUN npm ci --workspace=@life-kit/frontend --workspace=@life-kit/shared --include-workspace-root

COPY packages/shared packages/shared
COPY apps/frontend apps/frontend
RUN npm run build -w packages/shared && npm run build -w apps/frontend

FROM caddy:2-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/frontend/dist /srv
