PORT=3002
BACKEND_URL=http://backend:3001

# Same value as apps/backend's API_TOKEN, so this server can call the backend.
BACKEND_API_TOKEN=

# Separate token that MCP clients (Claude Code, Muse, etc.) must present to
# this server. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=
