PORT=3001
DB_PATH=./data/life-kit.sqlite

# Generate with: npm run hash-password -- 'your password here'
#
# IMPORTANT if this file will be read by `docker compose` (i.e. on the VPS,
# where docker-compose.yml loads it via env_file): bcrypt hashes contain
# literal "$" characters, and Compose's env_file parser interpolates $-syntax
# just like docker-compose.yml itself does. Double every "$" to "$$" in the
# hash you paste here, e.g. "$2a$12$abc..." becomes "$$2a$$12$$abc...".
# For local development (`npm run dev`, loaded by Node's dotenv instead),
# use the hash UN-escaped, exactly as hash-password prints it.
ADMIN_PASSWORD_HASH=

# Long, random static token for the MCP server / other programmatic clients.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=
